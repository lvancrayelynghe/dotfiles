#!/usr/bin/env bash
#
# Bootstraps this machine with mise. The configuration is declarative and the
# command is safe to re-run; it only installs missing tools/packages and
# repairs the dotfile links it owns.
set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$BASEDIR"

if ! command -v mise >/dev/null 2>&1; then
    echo "Installing mise with its official installer..."
    curl https://mise.run | sh
    export PATH="$HOME/.local/bin:$PATH"
fi

case "$(uname)" in
    Darwin) profile=macos ;;
    Linux)  profile=linux ;;
    *)      echo "Unsupported platform: $(uname)" >&2; exit 1 ;;
esac

# Trust is local mise state, not repository state. It permits a fresh clone to
# run this reviewed configuration without an interactive trust prompt.
mise trust "$BASEDIR"
mise -C "$BASEDIR" -E "$profile" bootstrap --yes "$@"

# A cask installed by Homebrew cannot safely be adopted in place by mise.
# Fresh Macs receive the declarative applications profile; an existing machine
# keeps its working apps until the user explicitly uninstalls those casks.
if [ "$profile" = macos ]; then
    if command -v brew >/dev/null 2>&1 && [ -n "$(brew list --cask 2>/dev/null)" ]; then
        echo "Homebrew-owned casks detected; skipped mise's macOS apps profile."
        echo "Migrate them deliberately, then run: mise -C $BASEDIR -E macos-apps bootstrap --only packages --yes"
    else
        mise -C "$BASEDIR" -E macos-apps bootstrap --only packages --yes "$@"
        bash "$BASEDIR/scripts/link-sublime.sh"
    fi
fi

echo "Bootstrap complete."
