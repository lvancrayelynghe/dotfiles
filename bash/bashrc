# bash interactive configuration. Shared aliases live in shell/aliases.sh
# (single source of truth with zsh); machine-local additions go to ~/.bashrc_local.

export DOTFILES_PATH=${DOTFILES_PATH:-$HOME/.dotfiles/public}
export BIN_PATH=${BIN_PATH:-$HOME/bin}

# Shell options (silently skipped on bash < 4 where unsupported)
for opt in autocd dirspell nocaseglob cdspell histappend cmdhist extglob no_empty_cmd_completion; do
    shopt -s "$opt" 2>/dev/null
done

mkdir -p "$HOME/.cache"

export HISTFILE="$HOME/.cache/bash_history"
export LESSHISTFILE=-
export MYSQL_HISTFILE=/dev/null

# ripgrep default flags (others/ripgreprc). Guarded like the zsh side: an
# unreadable path makes rg warn on stderr at every call, not just fall back.
[ -r "$HOME/.ripgreprc" ] && export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

export VISUAL='vim'
export EDITOR='vim'

# Prompt
WHITE="\[\e[97m\]"
RED="\[\e[31m\]"
CYAN="\[\e[36m\]"
NONE="\[\e[0m\]"
RESET="\033[m"
export PS1="[${WHITE}\u${NONE}@${RED}\h${NONE} ${CYAN}\w${NONE}]\\$\[${RESET}\] "

# GNU ls colors when available (Linux, or brew coreutils on macOS)
command -v dircolors >/dev/null 2>&1 && eval "$(dircolors)"

source "${DOTFILES_PATH}/shell/aliases.sh"
source "${DOTFILES_PATH}/zsh/functions.zsh"

alias bashrc='source ~/.bashrc' ## Reload config

# Machine-local additions (never committed)
[ -f "$HOME/.bashrc_local" ] && source "$HOME/.bashrc_local"

# mise: node/go/php toolchain versions. `mise activate` forks and costs ~14 ms,
# so cache its output and regenerate only when the binary is newer than the
# cache. Loaded after ~/.bashrc_local, like the zsh side, so mise owns the
# toolchain PATH rather than a version manager declared there.
if command -v mise >/dev/null 2>&1; then
    _mise_cache="$HOME/.cache/mise-activate.bash"
    if [ ! -f "$_mise_cache" ] || [ "$(command -v mise)" -nt "$_mise_cache" ]; then
        mkdir -p "$(dirname "$_mise_cache")"
        mise activate bash > "$_mise_cache"
    fi
    . "$_mise_cache"
    unset _mise_cache
fi
