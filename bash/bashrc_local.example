# Template for ~/.bashrc_local -- copy it, do not symlink it:
#
#     cp bash/bashrc_local.example ~/.bashrc_local
#
# NOT deployed by dotter, on purpose. The real file holds tokens, client
# hostnames and per-machine paths, none of which may ever reach this public
# repo. Keeping it a manual copy means editing it can never write back here.
#
# bash/bashrc sources it last, so anything here overrides the repo config.
# Read by bash only -- zsh has its own ~/.zshrc_local (see the zsh template).
#
# Everything below is optional -- delete what you do not need.


# ---------------------------------------------------------------------------
# Private aliases and environment
# ---------------------------------------------------------------------------
# alias myserver='ssh myserver.example.com'
# export SOME_API_TOKEN='...'   # tokens belong here, never in the repo


# ---------------------------------------------------------------------------
# nvm. Sourcing nvm.sh costs ~400 ms, so keep it lazy -- but put the default
# node's bin on PATH right away. Otherwise globally installed npm CLIs stay
# invisible until something triggers the lazy load, because nvm.sh is what
# adds that directory to PATH: `claude` and friends would just be not-found.
# ---------------------------------------------------------------------------
