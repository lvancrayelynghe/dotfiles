#!/usr/bin/env zsh
#
# Startup cost is measured from outside, never from instrumentation left in
# here: scripts/bench-shell.sh for the user-visible latencies,
# scripts/trace-shell.sh for the per-file attribution.

DOTFILES_PATH=${DOTFILES_PATH:-$HOME/.dotfiles/public}
BIN_PATH=${BIN_PATH:-$HOME/bin}
export HOSTNAME="$HOST"
HOST_CONFIG_FILE="$HOME/.zshrc_$HOST"
LOCAL_CONFIG_FILE="$HOME/.zshrc_local"

# Non-login interactive shells (su, screen, some IDE terminals) skip zprofile:
# source it here so PATH/EDITOR are always set. Idempotent and cheap.
[[ -o login ]] || source "${DOTFILES_PATH}/zsh/zprofile"

[[ -d "$HOME/.cache" ]] || mkdir -p "$HOME/.cache"

source "${DOTFILES_PATH}/zsh/global.zsh"
source "${DOTFILES_PATH}/zsh/plugins.zsh"
source "${DOTFILES_PATH}/zsh/completion.zsh"
source "${DOTFILES_PATH}/zsh/directories.zsh"
source "${DOTFILES_PATH}/zsh/history.zsh"
source "${DOTFILES_PATH}/zsh/key-bindings.zsh"
source "${DOTFILES_PATH}/shell/aliases.sh"
source "${DOTFILES_PATH}/zsh/aliases.zsh"
source "${DOTFILES_PATH}/zsh/functions.zsh"
source "${DOTFILES_PATH}/zsh/snippets.zsh"

[[ -e "$HOST_CONFIG_FILE" ]] && source "$HOST_CONFIG_FILE"
[[ -e "$LOCAL_CONFIG_FILE" ]] && source "$LOCAL_CONFIG_FILE"

source "${DOTFILES_PATH}/zsh/plugins/colored-man.plugin.zsh"

# fzf key bindings (Ctrl-R, Ctrl-T, Alt-C) and completion. `fzf --zsh` forks,
# and probing for it forked a second time -- ~20 ms each. Cache the generated
# script instead and regenerate it only when the binary is newer.
if command -v fzf >/dev/null 2>&1; then
    _fzf_cache="$HOME/.cache/fzf-init.zsh"
    if [[ ! -f "$_fzf_cache" || "$_fzf_cache" -ot "$commands[fzf]" ]]; then
        mkdir -p "${_fzf_cache:h}"
        # empty file on fzf < 0.48, which has no --zsh: the fallback below runs
        fzf --zsh > "$_fzf_cache" 2>/dev/null || : > "$_fzf_cache"
    fi
    if [[ -s "$_fzf_cache" ]]; then
        source "$_fzf_cache"
    elif [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then # distro package
        source /usr/share/doc/fzf/examples/key-bindings.zsh
    fi
    unset _fzf_cache
fi

# zoxide: smarter cd (z / zi)
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
    alias zd='zi'
fi

# mise: node/go/php toolchain versions. `mise activate` forks and costs ~14 ms,
# so cache its output and regenerate only when the binary is newer than the
# cache. Loaded here, after the local config files, so mise owns the toolchain
# PATH -- see the note in ~/.zshrc_local if nvm is still declared there.
if command -v mise >/dev/null 2>&1; then
    _mise_cache="$HOME/.cache/mise-activate.zsh"
    if [[ ! -f "$_mise_cache" || "$_mise_cache" -ot "$commands[mise]" ]]; then
        mkdir -p "${_mise_cache:h}"
        mise activate zsh > "$_mise_cache"
    fi
    source "$_mise_cache"
    unset _mise_cache
fi

if hash php >/dev/null 2>&1; then
    source "${DOTFILES_PATH}/zsh/plugins/laravel.plugin.zsh"
    if hash composer >/dev/null 2>&1; then
        source "${DOTFILES_PATH}/zsh/plugins/composer.plugin.zsh"
    fi
fi

if hash npm >/dev/null 2>&1; then
    source "${DOTFILES_PATH}/zsh/plugins/npm.plugin.zsh"
fi

source "${DOTFILES_PATH}/zsh/plugins/last-working-dir.plugin.zsh"
