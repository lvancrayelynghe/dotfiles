# ---------------------------------------------------------------------------
# A CLI installed outside any package manager, wrapped so it needs no PATH
# entry (the pattern used for gam, the Google Workspace admin CLI)
# ---------------------------------------------------------------------------
# [[ -x "$HOME/bin/mytool/mytool" ]] && function mytool() { "$HOME/bin/mytool/mytool" "$@" ; }
