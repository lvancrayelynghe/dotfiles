#!/usr/bin/env zsh
#
# Template for ~/.zshrc_local -- copy it, do not symlink it:
#
#     cp zsh/zshrc_local.example ~/.zshrc_local
#
# NOT deployed by mise, on purpose. The real file holds tokens, client
# hostnames and per-machine paths, none of which may ever reach this public
# repo. Keeping it a manual copy means editing it can never write back here.
#
# zsh/zshrc sources it last, so anything here overrides the repo config:
#   ~/.zshrc_$HOST   host-specific, same idea (see $HOST_CONFIG_FILE)
#   ~/.zshrc_local   this file, loaded on every machine
#
# Everything below is optional -- delete what you do not need.


# ---------------------------------------------------------------------------
# Private aliases: internal hosts, home automation, client shortcuts
# ---------------------------------------------------------------------------
# alias myserver='ssh myserver.example.com'
# alias vpn:up='sudo wg-quick up wg0'


# ---------------------------------------------------------------------------
# Per-repository git identity, switched by hand when cloning
# ---------------------------------------------------------------------------
# alias git:config-perso="git config --local user.name 'Your Name' && git config --local user.email 'you@example.com'"
# alias git:config-work="git config --local user.name 'Your Name' && git config --local user.email 'you@company.example'"


# ---------------------------------------------------------------------------
# Environment. zsh builtins, so no fork needed (keeps startup cheap)
# ---------------------------------------------------------------------------
# export HOST_UID=$EUID
# export HOST_GID=$GID
# export SOME_API_TOKEN='...'   # tokens belong here, never in the repo


# ---------------------------------------------------------------------------
# Completion for a tool that generates its own: dump it once into fpath
# (picked up by completion.zsh), regenerate only when the binary is newer.
# Generating on every startup would blow the startup ceiling (see CLAUDE.md).
# ---------------------------------------------------------------------------
# if (( $+commands[mytool] )); then
#     if [[ ! -f ~/.cache/zsh-completions/_mytool || ~/.cache/zsh-completions/_mytool -ot $commands[mytool] ]]; then
#         mkdir -p ~/.cache/zsh-completions
#         mytool --completion zsh > ~/.cache/zsh-completions/_mytool
#         # register in this shell and force a full compinit on the next one
#         fpath=(~/.cache/zsh-completions $fpath)
#         autoload -Uz _mytool && compdef _mytool mytool
#         rm -f "$ZSH_COMPDUMP"
#     fi
# fi


