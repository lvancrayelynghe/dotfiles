// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "font_weight": 600.0
  },
  "selection_highlight": true,
  // "combined" = Tree-sitter + tokens sémantiques du LSP (rendu façon VS Code)
  "semantic_tokens": "combined",
  // Grammaires manquantes pour la stack (coloration Blade/Vue), auto-installées au lancement
  "auto_install_extensions": { "blade": true, "vue": true, "gruvbox-material-mix": true },
  "icon_theme": "Zed (Default)",
  "when_closing_with_no_tabs": "keep_window_open",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "languages": {
    "PHP": {
      "format_on_save": "off"
    }
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "project_panel": {
    "file_icons": true,
    "dock": "left",
    "auto_fold_dirs": false
  },
  "base_keymap": "VSCode",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "minimap": {
    "show": "never"
  },
  "buffer_font_fallbacks": [
    "Menlo",
    "Monaco",
    "Courier New",
    "monospace"
  ],
  "buffer_font_family": "JetBrains Mono Medium",
  "show_whitespaces": "trailing",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "soft_wrap": "none",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  // Gruvbox Material (fork sainnhe) : palette Gruvbox retravaillée, accents
  // harmonisés et fond « hard », bien plus lisible que le Gruvbox built-in.
  "theme": "Gruvbox Material Dark Hard",
}
